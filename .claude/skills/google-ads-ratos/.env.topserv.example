# Copiar este arquivo pra ".env.topserv" (mesma pasta) e preencher. O .env.topserv é gitignored: nunca commitar, nunca colar em ticket/Slack.
# Usado por scripts/tsd.sh (Google Ads) e scripts/gtm.sh (GTM + GA4).

# Da agência, iguais pra todo mundo: pegar com o Edu (Bitwarden).
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Seu, gerado na sua máquina por: ./tsd.sh setup.py oauth  (autorizar com a SUA conta Google da TSD)
GOOGLE_ADS_REFRESH_TOKEN=

# MCC Topservdigital, sem hífens.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=4155514468

# Conta padrão quando --customer-id é omitido (All Heart). Mesmo assim: SEMPRE passar --customer-id explícito.
GOOGLE_ADS_CUSTOMER_ID=9205826499

# Seus, gerados por: ./gtm.sh gtm_setup.py oauth  e  ./gtm.sh ga4_setup.py oauth
GTM_REFRESH_TOKEN=
GA4_REFRESH_TOKEN=
